# =============================================
# ASHISH YADAV — AI PORTFOLIO — ENV EXAMPLE
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# This file is mounted into every Docker container via docker-compose.yml.

# ── REQUIRED for core apps to function ───────────────────────────────────────

# OpenAI — used by: 03, 04, 05, 06, 07, 08, 11, 13, 14, 15, 16, S2, S3, S4, S5, S7, S8
OPENAI_API_KEY=sk-...

# Groq — used by: 01, 02
GROQ_API_KEY=gsk_...

# Anthropic — used by: any project when user selects Anthropic in the provider sidebar
ANTHROPIC_API_KEY=sk-ant-...

# ── REQUIRED for ML / HuggingFace apps ───────────────────────────────────────

# HuggingFace — used by: 08 (fine-tune TinyLlama), 09 (BLIP model), S1 (LLM setup)
# Both names are checked — set either one (or both to be safe)
HUGGINGFACE_TOKEN=hf_...
HF_TOKEN=hf_...

# ── OPTIONAL — tracing & observability ───────────────────────────────────────

# LangSmith — used by: session-06 (browser automation tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=ai-agent-bootcamp

# ── OPTIONAL — secondary scripts (not Docker entry points) ───────────────────

# ScrapingDog — used by: session-06/12.amazon_review_scraper.py (not the main app)
# Get a key at https://scrapingdog.com
SCRAPINGDOG_API_KEY=

# Email (Gmail App Password) — used by: 07/app_email.py (not the main app)
# Create a Gmail App Password at myaccount.google.com/apppasswords
EMAIL_SENDER=your-email@gmail.com
EMAIL_APP_PASSWORD=

# ── LOCAL SERVICES ────────────────────────────────────────────────────────────

# Ollama (local inference — no key needed; set host if non-default)
OLLAMA_HOST=http://localhost:11434

# Cloudflare Tunnel — get token from: dash.cloudflare.com → Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
