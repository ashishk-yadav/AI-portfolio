# Copy this file to .env and fill in your values
# NEVER commit the .env file to source control

# --- OpenAI (used by: 03, 04, 05, 06, 07, 11, 13, 14, 15, 16, session2, session3, session4, session5, session7, session8) ---
OPENAI_API_KEY=sk-...

# --- Groq (used by: 01, 02) ---
GROQ_API_KEY=gsk_...

# --- LangSmith (optional — used by: session-06-browser-automation) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=ai-agent-bootcamp

# --- HuggingFace (optional — for private model downloads: 08, 09, fine-tune-llm) ---
HUGGINGFACE_TOKEN=hf_...

# --- Ollama (local — no key needed; set host if non-default) ---
OLLAMA_HOST=http://localhost:11434
